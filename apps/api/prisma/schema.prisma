generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // bcrypt hash; null for OAuth-only accounts
  username      String?   @unique
  name          String?
  avatar        String?
  bio           String?
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  groupMembers  GroupMember[]
  planMembers   PlanMember[]
  messages      Message[]
  expenses      Expense[]
  photos        Photo[]
  reminders     Reminder[]
  accounts      Account[]
  sessions      Session[]
  friendsAdded  Friendship[] @relation("FriendshipsInitiated")
  friendsOf     Friendship[] @relation("FriendshipsReceived")
  templates     PlanTemplate[]
}

model PlanTemplate {
  id        String   @id @default(cuid())
  name      String
  // Snapshot of the plan structure: { title, description, location, type,
  //   modules: string[], checkItems: [{title, category}], activities: [{title, notes}] }
  data      Json
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        String   @id @default(cuid())
  status    String   @default("accepted") // pending | accepted (existing rows stay accepted)
  createdAt DateTime @default(now())

  userId   String   // requester
  friendId String   // recipient
  user   User @relation("FriendshipsInitiated", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String    @id @default(cuid())
  name        String
  photo       String?
  description String?
  inviteCode  String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     GroupMember[]
  plans       Plan[]
  messages    Message[]
}

model GroupMember {
  id       String   @id @default(cuid())
  role     String   @default("member") // admin | member
  muted    Boolean  @default(false)
  status   String   @default("member") // invited | member — invited users must accept before joining
  joinedAt DateTime @default(now())

  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Plan {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("full") // full | quick
  status      String    @default("upcoming") // upcoming | active | completed
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  notes       String    @default("") // shared notepad
  inviteCode  String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Optional link to a group (plans are independent; members are invited
  // directly or in bulk from groups at creation time)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  members     PlanMember[]
  modules     PlanModule[]
  messages    Message[]
  activities  Activity[]
  checkItems  CheckItem[]
  expenses    Expense[]
  photos      Photo[]
  reminders   Reminder[]
  votes       Vote[]
  songs       Song[]
  files       PlanFile[]
}

model PlanModule {
  id        String   @id @default(cuid())
  type      String   // expenses | checklist | activities | votes | walkietalkie | gallery | playlist | files | meetup
  order     Int      @default(0)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, type])
}

model PlanMember {
  id       String   @id @default(cuid())
  rsvp         String   @default("pending") // yes | no | maybe | pending
  role         String   @default("member") // admin | helper | member
  status       String   @default("member") // invited | member — invited users must accept before joining
  meetupStatus String   @default("none") // none | home | onway | there
  lat          Float?   // live location while sharing
  lng          Float?
  locationAt   DateTime?
  joinedAt     DateTime @default(now())

  userId String
  planId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId  String?
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  time      DateTime?
  order     Int      @default(0)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model CheckItem {
  id          String   @id @default(cuid())
  title       String
  category    String?
  checked     Boolean  @default(false)
  assignedTo  String?
  createdAt   DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String?
  splitMethod String   @default("equal") // equal | custom
  createdAt   DateTime @default(now())

  planId  String
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  paidBy  String
  payer   User   @relation(fields: [paidBy], references: [id])

  splits  ExpenseSplit[]
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  userId    String
  amount    Float
  settled   Boolean @default(false)

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  title     String
  fireAt    DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vote {
  id        String   @id @default(cuid())
  question  String
  options   Json
  results   Json     @default("{}")
  closesAt  DateTime?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PlanFile {
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int      @default(0)
  data      String   // base64 data URL
  addedBy   String   // user id
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  source    String   // spotify | youtube
  url       String   // link to the track
  addedBy   String   // user id
  votes     Json     @default("{}") // { userId: 1 | -1 }
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

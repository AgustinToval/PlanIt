generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // bcrypt hash; null for OAuth-only accounts
  // Discord-style identity: username + 4-digit tag, unique as a PAIR
  // (two people can both be "agus" with different tags: agus#4821, agus#0193)
  username      String?
  tag           String    @default("0000")
  pushToken     String?   // Expo push token for mobile notifications
  name          String?
  avatar        String?
  bio           String?
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  groupMembers  GroupMember[]
  planMembers   PlanMember[]
  messages      Message[]
  expenses      Expense[]
  photos        Photo[]
  reminders     Reminder[]
  accounts      Account[]
  sessions      Session[]
  friendsAdded  Friendship[] @relation("FriendshipsInitiated")
  friendsOf     Friendship[] @relation("FriendshipsReceived")
  templates     PlanTemplate[]
  availability  Availability[]
  voiceClips    VoiceClip[]

  @@unique([username, tag])
}

model PlanTemplate {
  id        String   @id @default(cuid())
  name      String
  // Snapshot of the plan structure: { title, description, location, type,
  //   modules: string[], checkItems: [{title, category}], activities: [{title, notes}] }
  data      Json
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id        String   @id @default(cuid())
  status    String   @default("accepted") // pending | accepted (existing rows stay accepted)
  createdAt DateTime @default(now())

  userId   String   // requester
  friendId String   // recipient
  user   User @relation("FriendshipsInitiated", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String    @id @default(cuid())
  name        String
  photo       String?
  description String?
  inviteCode  String    @unique @default(cuid())
  lastActivityAt DateTime @default(now()) // bumped on chat activity, used for list ordering
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     GroupMember[]
  plans       Plan[]
  messages    Message[]
}

model GroupMember {
  id         String   @id @default(cuid())
  role       String   @default("member") // admin | member
  muted      Boolean  @default(false)
  status     String   @default("member") // invited | member — invited users must accept before joining
  lastSeenAt DateTime @default(now()) // when I last opened this group's chat
  joinedAt   DateTime @default(now())

  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Plan {
  id          String    @id @default(cuid())
  title       String
  description String?
  bannerImage String?   // compressed data-URL shown behind the plan card
  type        String    @default("full") // full | quick
  status      String    @default("upcoming") // upcoming | active | completed
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  notes       String    @default("") // shared notepad
  inviteCode  String    @unique @default(cuid())
  lastActivityAt DateTime @default(now()) // bumped on any interaction, used for list ordering
  moduleActivity Json     @default("{}")  // { chat: iso, expenses: iso, ... } last change per module
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Optional link to a group (plans are independent; members are invited
  // directly or in bulk from groups at creation time)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  members     PlanMember[]
  modules     PlanModule[]
  messages    Message[]
  activities  Activity[]
  checkItems  CheckItem[]
  expenses    Expense[]
  photos      Photo[]
  reminders   Reminder[]
  votes       Vote[]
  songs       Song[]
  files       PlanFile[]
  voiceClips  VoiceClip[]
  guests      PlanGuest[]
  raffles     Raffle[]
}

model PlanModule {
  id        String   @id @default(cuid())
  type      String   // expenses | checklist | activities | votes | walkietalkie | gallery | playlist | files | meetup
  order     Int      @default(0)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, type])
}

model PlanMember {
  id       String   @id @default(cuid())
  rsvp         String   @default("pending") // yes | no | maybe | pending
  role         String   @default("member") // admin | helper | member
  status       String   @default("member") // invited | member — invited users must accept before joining
  meetupStatus String   @default("none") // none | home | onway | there
  walkieOptIn  String   @default("pending") // pending | accepted | declined — consent to the walkie talkie channel
  lat          Float?   // live location while sharing
  lng          Float?
  locationAt   DateTime?
  moduleSeen   Json     @default("{}") // { chat: iso, ... } when I last opened each module
  joinedAt     DateTime @default(now())

  userId String
  planId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId  String?
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  time      DateTime?
  order     Int      @default(0)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model CheckItem {
  id          String   @id @default(cuid())
  title       String
  category    String?
  checked     Boolean  @default(false)
  assignedTo  String?
  createdAt   DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String?
  splitMethod String   @default("equal") // equal | custom
  createdAt   DateTime @default(now())

  planId  String
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  paidBy  String
  payer   User   @relation(fields: [paidBy], references: [id])

  splits  ExpenseSplit[]
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  userId    String  // a User id OR a PlanGuest id (guests have no account)
  amount    Float
  settled   Boolean @default(false)

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// A raffle wheel inside a plan. Participants are a snapshot of names
// (members and/or guests) so edits to the plan don't rewrite past raffles.
model Raffle {
  id           String    @id @default(cuid())
  title        String
  participants Json      // [{ id, name }] — id is a User id or PlanGuest id
  winnerId     String?   // participant id of the last spin result
  winnerName   String?
  spunAt       DateTime?
  createdBy    String    // user id
  createdAt    DateTime  @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// A person without the app who still shares expenses in a plan (e.g. "Juan").
// Plan-scoped: guests exist only inside the plan they were added to.
model PlanGuest {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  title     String
  fireAt    DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vote {
  id        String   @id @default(cuid())
  question  String
  options   Json
  results   Json     @default("{}")
  closesAt  DateTime?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Availability {
  id     String @id @default(cuid())
  date   String // YYYY-MM-DD (string avoids timezone drift)
  status String // free | maybe | busy

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model VoiceClip {
  id        String   @id @default(cuid())
  url       String   // base64 data URL (audio/m4a)
  duration  Float    @default(0)
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanFile {
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int      @default(0)
  data      String   // base64 data URL
  addedBy   String   // user id
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Song {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  source    String   // spotify | youtube
  url       String   // link to the track
  cover     String?  // thumbnail/cover art from oEmbed
  addedBy   String   // user id
  votes     Json     @default("{}") // { userId: 1 | -1 }
  createdAt DateTime @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}
